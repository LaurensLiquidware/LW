# Copy to ".env" next to the running binary to set these without exporting
# environment variables by hand (see internal/dotenv). Every line below is
# optional -- the server runs fine with none of them set.

# Address the HTTP server binds to. Loopback-only by default since this is
# a local, single-user tool, not a multi-tenant service.
#FVS_HTTP_ADDR=127.0.0.1:8743

# Deployment label ("development", "production", ...). Only affects
# FVS_LOG_LEVEL's default (debug in development, info otherwise).
#FVS_ENVIRONMENT=production

# One of: debug, info, warn, error.
#FVS_LOG_LEVEL=info

# Log file path, in addition to stderr. Relative to the process's working
# directory.
#FVS_LOG_FILE=./flexapp-vuln-scanner.log

# Scan output folder pre-filled in the New Scan screen.
#FVS_DEFAULT_OUTPUT_DIR=./scan-out

# On-disk OSV/NVD response cache directory.
#FVS_CACHE_DIR=./cache

# Optional NVD 2.0 API key. Unset means unauthenticated (rate-limited) NVD
# requests -- see https://nvd.nist.gov/developers/request-an-api-key.
#FVS_NVD_API_KEY=

# Where the list of past scans is persisted (JSON), so scan history
# survives restarting the app.
#FVS_SCAN_HISTORY_FILE=./scan-history.json

# Path to the PowerShell Stage 1 inventory script this process shells out
# to.
#FVS_STAGE1_SCRIPT=./stage1-extract/Invoke-FlexAppInventory.ps1

# Manual vendor/product -> CPE override table used during vulnerability
# matching and SBOM building.
#FVS_CPE_MAPPINGS_PATH=./config/cpe-mappings.yaml
