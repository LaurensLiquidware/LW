{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liquidware.internal/flexapp-vuln-scanner/inventory.schema.json",
  "title": "FlexApp Vulnerability Scanner - Stage 1 Inventory",
  "description": "Contract between Stage 1 (PowerShell extraction/inventory) and Stage 2 (Python resolution/matching). See PLAN.md for the full design rationale.",
  "type": "object",
  "required": ["schemaVersion", "package", "files"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "package": {
      "type": "object",
      "required": ["sourcePath", "packageType", "scanStartedUtc", "scanFinishedUtc", "toolVersion"],
      "additionalProperties": false,
      "properties": {
        "sourcePath": { "type": "string" },
        "packageType": { "enum": ["classic-vhdx", "flexapp-one"] },
        "flexAppXml": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "uuid": { "type": ["string", "null"] },
            "displayName": { "type": ["string", "null"] },
            "packageType": { "type": ["string", "null"] },
            "sizeInGb": { "type": ["number", "null"] },
            "actualSizeInBytes": { "type": ["integer", "null"] },
            "dateCreated": { "type": ["string", "null"] },
            "dateModified": { "type": ["string", "null"] },
            "historyRaw": { "type": "array", "items": { "type": "string" } },
            "versionMajorMinorBuildRevision": { "type": ["string", "null"] },
            "shortcutTargets": { "type": "array", "items": { "type": "string" } },
            "installerIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "scanStartedUtc": { "type": "string", "format": "date-time" },
        "scanFinishedUtc": { "type": "string", "format": "date-time" },
        "toolVersion": { "type": "string" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relativePath", "sizeBytes", "excluded", "componentType", "identity", "readError"],
        "additionalProperties": false,
        "properties": {
          "relativePath": { "type": "string" },
          "sizeBytes": { "type": ["integer", "null"] },
          "sha256": { "type": ["string", "null"] },
          "excluded": { "type": "boolean" },
          "exclusionReason": { "type": ["string", "null"] },
          "componentType": {
            "enum": [
              "pe-native",
              "jar",
              "node-package",
              "python-dist",
              "dotnet-package",
              "native-string-scan",
              "unknown"
            ]
          },
          "identity": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "method": {
                "enum": [
                  "pe-version-resource",
                  "dotnet-manifest",
                  "jar-pom-properties",
                  "jar-manifest",
                  "node-package-json",
                  "electron-embedded",
                  "python-dist-info",
                  "dotnet-deps-json",
                  "string-signature"
                ]
              },
              "vendor": { "type": ["string", "null"] },
              "product": { "type": ["string", "null"] },
              "version": { "type": ["string", "null"] },
              "raw": { "type": "object" }
            },
            "required": ["method"]
          },
          "readError": { "type": ["string", "null"] }
        }
      }
    }
  }
}
