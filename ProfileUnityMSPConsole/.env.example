# Copy to .env and fill in. See README.md "Configuration".
#
# Everything down to PUMC_BOOTSTRAP_ADMIN_USERNAME/PASSWORD below is read
# every startup -- these are what the process needs before it can even
# open its own database. Everything after that (TLS cert paths,
# collection tunables, session timeouts, SMTP/report-email) is only ever
# a SEED: read once on a completely fresh database, then never consulted
# again -- from then on it lives in the database, and the Settings
# screen in the app is how you change any of it, live, with no restart.
# Editing those values here after the first startup has no effect.

# Address the HTTP server binds to. Defaults to 0.0.0.0:8443 (all
# interfaces) if left unset; set this explicitly to bind to a specific
# interface/port instead.
PUMC_HTTP_ADDR=0.0.0.0:8443

# "development" or "production". Sets the default log level: debug in
# development, info in production (see PUMC_LOG_LEVEL below).
PUMC_ENVIRONMENT=development

# sqlite (default) or postgres.
PUMC_DB_DRIVER=sqlite

# For sqlite: a file path. For postgres: a standard DSN.
PUMC_DB_DSN=./profileunity-msp-console.db

# If a demo.db file exists next to PUMC_DB_DSN's directory (sqlite only),
# the server runs against it instead of the real database -- see README.md's
# "Demo data" section. Set to "off" to force the real database even when
# demo.db is present. Leave unset otherwise.
PUMC_DEMO_MODE=

# debug, info, warn, or error. Leave unset to default from
# PUMC_ENVIRONMENT (debug in development, info otherwise); set explicitly
# to override that default in either environment.
#PUMC_LOG_LEVEL=info

# Where logs are written, in addition to stderr/console. Relative to the
# working directory, same convention as PUMC_DB_DSN.
PUMC_LOG_FILE=./profileunity-msp-console.log

# Base64-encoded 32-byte (AES-256) key used to encrypt stored tenant
# credentials at rest. Leave unset and one is generated automatically on
# first boot and saved to PUMC_CREDENTIAL_ENCRYPTION_KEY_FILE below --
# BACK UP THAT FILE, since losing or replacing it means losing the
# ability to decrypt every stored tenant credential, by design. Set this
# explicitly instead if you want to supply/rotate your own key, e.g.:
#   openssl rand -base64 32
PUMC_CREDENTIAL_ENCRYPTION_KEY=

# Where the auto-generated credential encryption key above is saved when
# PUMC_CREDENTIAL_ENCRYPTION_KEY is left unset. Relative to the working
# directory, same convention as PUMC_DB_DSN. Ignored if
# PUMC_CREDENTIAL_ENCRYPTION_KEY is set explicitly.
PUMC_CREDENTIAL_ENCRYPTION_KEY_FILE=./credential-encryption.key

# Creates the first operator account at startup if none exist yet (only
# ever runs when the users table is empty -- has no effect afterward, so
# leave both unset once you have a real account). Leaving both unset
# creates a built-in "LiquidwareMSP"/"LiquidwareMSP" account instead of
# skipping bootstrap -- change that password from the change-password
# screen right after your first login. Set both here to use your own
# username/password instead.
PUMC_BOOTSTRAP_ADMIN_USERNAME=
PUMC_BOOTSTRAP_ADMIN_PASSWORD=

# --- Everything below is a seed value only -- see the note at the top of
# this file. Change any of it afterward from the Settings screen. ---

# TLS certificate/key paths. If both files already exist they are used
# as-is (put your own CA-signed pair here); otherwise a self-signed pair
# is generated at these paths on first startup. The server always serves
# HTTPS -- there is no plain-HTTP mode. Only consulted on a fresh
# install with nothing in the database yet -- replace the certificate
# from the Settings screen afterward, not by editing these paths.
PUMC_TLS_CERT_FILE=./tls-cert.pem
PUMC_TLS_KEY_FILE=./tls-key.pem

# How often the scheduler checks whether it's time to collect. Snapshots
# are keyed by calendar day and upserted, so ticking more often than daily
# is harmless -- it just keeps refreshing today's row. Go duration syntax.
PUMC_COLLECTION_INTERVAL=1h

# IANA timezone used only to compute the collection-day boundary. Stored
# timestamps are always UTC regardless of this setting.
PUMC_COLLECTION_TIMEZONE=UTC

# Maximum number of tenants polled concurrently.
PUMC_COLLECTION_CONCURRENCY=5

# Per-tenant timeout, including retries. One slow/dead tenant must never
# stall the whole run.
PUMC_COLLECTION_TENANT_TIMEOUT=30s

# How long a console operator's session survives without activity, and
# the hard cap on a session regardless of activity.
PUMC_SESSION_IDLE_TIMEOUT=30m
PUMC_SESSION_ABSOLUTE_TIMEOUT=12h

# Automatically emails the MSP-wide portfolio PDF report once a month.
# Leave PUMC_SMTP_HOST unset (the default) to disable this entirely --
# nothing is ever sent. Username/password may stay empty for a relay that
# doesn't require auth; every other SMTP_* setting below is required once
# a host is set.
PUMC_SMTP_HOST=
PUMC_SMTP_PORT=587
PUMC_SMTP_USERNAME=
PUMC_SMTP_PASSWORD=
PUMC_SMTP_FROM=

# How the SMTP connection is secured: starttls (default, the usual case
# for port 587), tls (implicit TLS from the first byte, port 465), or
# none (unencrypted, for a local relay only).
PUMC_SMTP_SECURITY=starttls

# Who the monthly portfolio report is emailed to, comma-separated.
PUMC_REPORT_RECIPIENTS=msp@liquidware.eu

# Day of the month (1-28, in PUMC_COLLECTION_TIMEZONE) the previous
# month's portfolio report is sent -- 1 sends on the 1st for the month
# that just ended.
PUMC_REPORT_EMAIL_DAY=1
