# Copy to .env and fill in. See README.md "Configuration".
# More settings (SMTP, TLS) are added in later build phases as those
# features land.

# Address the HTTP server binds to. No default is baked in on purpose —
# this is a multi-user server, not a local single-operator tool. Example
# for a machine reachable on your network:
PUMC_HTTP_ADDR=0.0.0.0:8443

# "development" or "production". Affects logging verbosity only for now.
PUMC_ENVIRONMENT=development

# sqlite (default) or postgres.
PUMC_DB_DRIVER=sqlite

# For sqlite: a file path. For postgres: a standard DSN.
PUMC_DB_DSN=./profileunity-msp-console.db

# debug, info, warn, or error.
PUMC_LOG_LEVEL=info

# How often the scheduler checks whether it's time to collect. Snapshots
# are keyed by calendar day and upserted, so ticking more often than daily
# is harmless -- it just keeps refreshing today's row. Go duration syntax.
PUMC_COLLECTION_INTERVAL=1h

# IANA timezone used only to compute the collection-day boundary. Stored
# timestamps are always UTC regardless of this setting.
PUMC_COLLECTION_TIMEZONE=UTC

# Maximum number of tenants polled concurrently.
PUMC_COLLECTION_CONCURRENCY=5

# Per-tenant timeout, including retries. One slow/dead tenant must never
# stall the whole run.
PUMC_COLLECTION_TENANT_TIMEOUT=30s

# Base64-encoded 32-byte (AES-256) key used to encrypt stored tenant
# credentials at rest. Generate one with, e.g.:
#   openssl rand -base64 32
# Held outside the database on purpose -- losing this key means losing
# the ability to decrypt any stored credential, by design. Leave unset if
# no tenant will ever have credentials configured.
PUMC_CREDENTIAL_ENCRYPTION_KEY=
