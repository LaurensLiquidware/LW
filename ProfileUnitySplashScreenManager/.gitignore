# Build output
/dist/
/resource_windows.syso
/build/versioninfo.generated.json

# The embedded UI is a build product, regenerated by cmd/build from web/dist.
# The committed placeholder in internal/static/ui/index.html is tracked; the
# real build output is not.
/internal/static/ui/*
!/internal/static/ui/index.html

# Node
/web/node_modules/
/web/dist/
/web/.angular/

# Generated at build time from PRIMEUI_LICENSE_KEY -- a commercial per-developer
# license key. Never commit this.
/web/src/app/primeui-license.generated.ts

# Go
*.test
*.out
/build/app.manifest.generated
